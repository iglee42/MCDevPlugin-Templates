org.gradle.jvmargs=-Xmx2G
org.gradle.daemon=true
#if (${VERSIONS.minecraft.compareTo($mcver.MC1_21)} >= 0)
org.gradle.parallel=true
org.gradle.caching=true
org.gradle.configuration-cache=true
#end
minecraft_version=${VERSIONS.minecraft}
minecraft_version_range=[${VERSIONS.minecraft},${VERSIONS.minecraftNext})
neo_version=${VERSIONS.neoforge}
neo_version_range=[${VERSIONS.neoforgeSpec},)
#if (${VERSIONS.minecraft.compareTo($mcver.MC1_21)} >= 0)
loader_version_range=[4,)
#else
loader_version_range=[2,)
#end

#if (${VERSIONS.minecraft.compareTo($mcver.MC1_21)} >= 0)
#if (${PARCHMENT.use})
parchment_minecraft_version=${PARCHMENT.minecraftVersion}
parchment_mappings_version=${PARCHMENT.version}
#end
#else
#if (${PARCHMENT.use})
neogradle.subsystems.parchment.minecraftVersion=${PARCHMENT.minecraftVersion}
neogradle.subsystems.parchment.mappingsVersion=${PARCHMENT.version}
#end
#end
mod_id=${MOD_ID}
mod_name=${MOD_NAME}
mod_license=${LICENSE.name}
mod_version=${BUILD_COORDS.version}
mod_group_id=${BUILD_COORDS.groupId}
mod_authors=${AUTHORS}
mod_description=${DESCRIPTION}

publish_display_name=${MOD_NAME} ${BUILD_COORDS.version} for mc${VERSIONS.minecraft}
publish_changelog=Automated release
publish_modrinth_project_id=
publish_curseforge_project_id=
publish_curseforge_project_slug=
publish_github_repository=
publish_github_tag_name=${BUILD_COORDS.version}-${VERSIONS.minecraft}

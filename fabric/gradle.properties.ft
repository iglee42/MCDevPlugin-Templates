# Done to increase the memory available to gradle.
org.gradle.jvmargs=-Xmx1G

# Fabric Properties
	# check these on https://modmuss50.me/fabric.html
	minecraft_version=${VERSIONS.minecraftVersion}
#if (!${VERSIONS.useOfficialMappings})
	yarn_mappings=${VERSIONS.yarn}
#end
	loader_version=${VERSIONS.loader}

# Mod Properties
	mod_version = ${BUILD_COORDS.version}
	maven_group = ${BUILD_COORDS.groupId}
	archives_base_name = ${BUILD_COORDS.artifactId}

#if (${VERSIONS.useFabricApi})
# Dependencies
	# check this on https://modmuss50.me/fabric.html
	fabric_version=${VERSIONS.fabricApi}
#end

publish_display_name=${MOD_NAME} ${BUILD_COORDS.version} for mc${VERSIONS.minecraftVersion}
publish_maven_repository_url=${PUBLISH_MAVEN_REPOSITORY_URL}
publish_modrinth_project_id=${PUBLISH_MODRINTH_PROJECT_ID}
publish_curseforge_project_id=${PUBLISH_CURSEFORGE_PROJECT_ID}
publish_curseforge_project_slug=${PUBLISH_CURSEFORGE_PROJECT_SLUG}
#if ($PUBLISH_GITHUB_REPOSITORY != "")
publish_github_repository=${PUBLISH_GITHUB_REPOSITORY}
#elseif ($AUTHOR_NAME != "")
publish_github_repository=${AUTHOR_NAME}/${MOD_ID}
#else
publish_github_repository=
#end
publish_github_tag_name=${BUILD_COORDS.version}-${VERSIONS.minecraftVersion}

plugins {
#if ($VERSIONS.minecraftVersion.compareTo($mcver.MC26_1) >= 0)
    id 'net.fabricmc.fabric-loom' version '${VERSIONS.loom}'
#else
    id 'fabric-loom' version '${VERSIONS.loom}'
#end
    id 'maven-publish'
    id 'dev.ithundxr.silk' version '1.0.1'
    id 'me.modmuss50.mod-publish-plugin' version '1.1.0'
}

version = project.mod_version
group = project.maven_group

String gitHash = calculateGitHash()
String changelogText = silk.getChangelog()

base {
    archivesName = project.archives_base_name
}

#if ($SPLIT_SOURCES && $VERSIONS.minecraftVersion.compareTo($mcver.MC1_18) >= 0)
loom {
    splitEnvironmentSourceSets()

    mods {
        "${MOD_ID}" {
            sourceSet sourceSets.main
            sourceSet sourceSets.client
        }
    }
}
#end

#if ($USE_DATAGEN)
fabricApi {
    configureDataGeneration {
        client = true
    }
}
#end

repositories {
}

dependencies {
    minecraft "com.mojang:minecraft:${project.minecraft_version}"
#if ($VERSIONS.minecraftVersion.compareTo($mcver.MC26_1) >= 0)
    implementation "net.fabricmc:fabric-loader:${project.loader_version}"
    
    #if (${VERSIONS.useFabricApi})
        implementation "net.fabricmc.fabric-api:fabric-api:${project.fabric_version}"
    #end
#else
    #if (${VERSIONS.useOfficialMappings})
        mappings loom.officialMojangMappings()
    #else
        mappings "net.fabricmc:yarn:${project.yarn_mappings}:v2"
    #end
    modImplementation "net.fabricmc:fabric-loader:${project.loader_version}"

    #if (${VERSIONS.useFabricApi})
        modImplementation "net.fabricmc.fabric-api:fabric-api:${project.fabric_version}"
    #end
#end
}

processResources {
    inputs.property "version", project.version
    inputs.property "minecraft_version", project.minecraft_version
    inputs.property "loader_version", project.loader_version
    filteringCharset "UTF-8"

    filesMatching("fabric.mod.json") {
        expand "version": project.version,
                "minecraft_version": project.minecraft_version,
                "loader_version": project.loader_version
    }
}

def targetJavaVersion = ${JAVA_VERSION}
tasks.withType(JavaCompile).configureEach {
    it.options.encoding = "UTF-8"
    if (targetJavaVersion >= 10 || JavaVersion.current().isJava10Compatible()) {
        it.options.release.set(targetJavaVersion)
    }
}

java {
    def javaVersion = JavaVersion.toVersion(targetJavaVersion)
    if (JavaVersion.current() < javaVersion) {
        toolchain.languageVersion = JavaLanguageVersion.of(targetJavaVersion)
    }
    withSourcesJar()
}

jar {
    from("LICENSE") {
        rename { "${it}_${project.archives_base_name}"}
    }
}

publishMods {
    file = tasks.jar.archiveFile
    displayName = providers.gradleProperty("publish_display_name").orElse("${mod_name} ${mod_version} for mc${minecraft_version}").get()
    version = project.version
    changelog = silk.changelog
    type = STABLE
    modLoaders.add("fabric")
    dryRun = providers.environmentVariable("DRY_RUN").map { it == "true" }.orElse(false).get()

    def modrinthProjectId = providers.gradleProperty("publish_modrinth_project_id").orNull
    if (modrinthProjectId) {
        modrinth {
            accessToken = providers.environmentVariable("MODRINTH_TOKEN")
            projectId = modrinthProjectId
            minecraftVersions.add(minecraft_version)
        }
    }

    def curseforgeProjectId = providers.gradleProperty("publish_curseforge_project_id").orNull
    if (curseforgeProjectId) {
        curseforge {
            accessToken = providers.environmentVariable("CURSEFORGE_TOKEN")
            projectId = curseforgeProjectId
            projectSlug = providers.gradleProperty("publish_curseforge_project_slug").orNull
            minecraftVersions.add(minecraft_version)
            changelogType = "markdown"
            clientRequired = true
            serverRequired = true
        }
    }

    def githubRepository = providers.gradleProperty("publish_github_repository").orNull
    if (githubRepository) {
        github {
            accessToken = providers.environmentVariable("GITHUB_TOKEN")
            repository = githubRepository
            commitish = gitHash
            tagName = providers.gradleProperty("publish_github_tag_name").orElse("${mod_version}-${minecraft_version}").get()
            file.unset()
            file.unsetConvention()
            allowEmptyFiles = true
        }
    }

    def discordContent = changelogText.length() > 4000
        ? "Changelog is too long, check it on Modrinth."
        : changelogText

    discord {
        webhookUrl = providers.environmentVariable("DISCORD_WEBHOOK")
        dryRunWebhookUrl = providers.environmentVariable("DISCORD_WEBHOOK_DRY_RUN")
        content = """
                # ${mod_name} | ${mod_version}

                $discordContent
            """.stripIndent()

        style {
            link = "BUTTON"
            look = "MODERN"
            thumbnailUrl = "https://cdn.modrinth.com/data/hSSqdyU1/e7229e03d0795915092cdab361ee4406e0b27153_96.webp"
            color = "curseforge"
        }
    }
}

publishing {
    publications {
        create("mavenJava", MavenPublication) {
            artifactId = project.archives_base_name
            from components.java
        }
    }

    repositories {
        maven {
            name = 'fabricRepo'
            url = providers.gradleProperty("publish_maven_repository_url").orElse("https://maven.iglee.fr/releases").get()
            credentials {
                username = providers.environmentVariable("MAVEN_USERNAME").orNull
                password = providers.environmentVariable("MAVEN_PASSWORD").orNull
            }
            authentication {
                basic(BasicAuthentication)
            }
        }
    }
}

String calculateGitHash() {
    try {
        ExecOutput output = providers.exec {
            commandLine("git", "rev-parse", "HEAD")
        }
        return output.standardOutput.asText.get().trim()
    } catch (Throwable ignored) {
        return "unknown"
    }
}
